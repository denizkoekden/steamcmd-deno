# .env
PORT=8000
# Leave REDIS_HOST and REDIS_PORT unset or empty to disable caching
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=your_redis_password  # If no password, leave it blank
CACHE_EXPIRATION=600
# CACHE_PRELOAD_APP_IDS=440,730
# CACHE_PRELOAD_USERNAME=
# CACHE_PRELOAD_PASSWORD=
# CACHE_PRELOAD_INTERVAL_MS=  # defaults to CACHE_EXPIRATION * 1000 / 2
STEAM_REQUEST_TIMEOUT_MS=15000
STEAM_REQUEST_DELAY_MS=0
# steamcmd is only invoked for private/beta branches (X-Steam-Beta-Password header).
# In the Docker image this defaults to /opt/steamcmd/steamcmd.sh; for bare-metal Deno
# set it to your local steamcmd binary (e.g. /usr/games/steamcmd).
# STEAMCMD_PATH=/opt/steamcmd/steamcmd.sh
# STEAMCMD_TIMEOUT_MS=60000
LOG_LEVEL=INFO
